{
  "name": "rabbitmq-messaging-lab-node",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "basic:producer": "node --env-file=../.env examples/01-basic-queue/producer.mjs",
    "basic:consumer": "node --env-file=../.env examples/01-basic-queue/consumer.mjs",
    "direct:producer": "node --env-file=../.env examples/02-direct-exchange/producer.mjs",
    "topic:producer": "node --env-file=../.env examples/03-topic-exchange/producer.mjs",
    "fanout:producer": "node --env-file=../.env examples/04-fanout-exchange/producer.mjs",
    "headers:producer": "node --env-file=../.env examples/05-headers-exchange/producer.mjs",
    "binding:producer": "node --env-file=../.env examples/06-binding-exchanges/producer.mjs",
    "max-priority:producer": "node --env-file=../.env examples/07-max-priority/producer.mjs",
    "document-processing:project": "tsx --env-file=../.env projects/document-processing/src/index.ts",
    "document-processing:migrate": "knex --knexfile projects/document-processing/knexfile.ts migrate:latest",
    "document-processing:rollback": "knex --knexfile projects/document-processing/knexfile.ts migrate:rollback",
    "document-processing:seed": "knex --knexfile projects/document-processing/knexfile.ts seed:run"
  },
